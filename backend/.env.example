PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/dsa_tracker
MONGO_MAX_POOL_SIZE=10
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_JWT_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
ADMIN_SETUP_EMAIL=authorized-admin@example.com
CRON_SCHEDULE=0 */6 * * *
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
